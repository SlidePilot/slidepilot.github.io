---
import Glyph from './Glyph.astro';
interface Props { size?: number; class?: string }
const { size = 28, class: cls } = Astro.props;
---
<span class:list={['app-icon', cls]} style={`--s:${size}px`} aria-hidden="true">
  <Glyph id={`ai${size}`} />
</span>
<style>
  .app-icon {
    width: var(--s); height: var(--s);
    border-radius: calc(var(--s) * 0.26);
    background: linear-gradient(180deg, #3da8ff 0%, #0057f0 70%);
    display: grid; place-items: center;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.22), 0 4px 14px -4px rgba(30,107,245,.7);
    flex: none;
  }
  .app-icon :global(svg) { width: 74%; height: auto; filter: drop-shadow(0 1px 1px rgba(0,40,120,.35)); }
</style>
