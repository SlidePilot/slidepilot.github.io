---
import Icon from '../Icon.astro';
import type { Dict } from '../../i18n/en';
interface Props { d: Dict }
const { d } = Astro.props;
const p = d.privacy;
---
<section class="privacy">
  <div class="container">
    <div class="band card reveal">
      <div class="shield" aria-hidden="true"><Icon name="lock" size={30} /></div>
      <div class="txt">
        <h2>{p.title}</h2>
        <p>{p.text}</p>
      </div>
    </div>
  </div>
</section>
<style>
  .privacy { padding: 20px 0; }
  .band { display: grid; grid-template-columns: auto 1fr; gap: 28px; align-items: center; padding: 32px 36px; background: linear-gradient(120deg, rgba(30,107,245,.16), rgba(255,255,255,.02) 60%); }
  .shield { width: 64px; height: 64px; border-radius: 18px; display: grid; place-items: center; background: linear-gradient(#3da8ff, #0057f0 75%); box-shadow: 0 10px 30px -8px rgba(30,107,245,.8), inset 0 1px 0 rgba(255,255,255,.35); }
  h2 { font-size: clamp(22px, 2.6vw, 28px); font-weight: 650; }
  .txt p { color: var(--text-2); margin-top: 6px; max-width: 560px; }
  @media (max-width: 900px) { .band { grid-template-columns: 1fr; } }
</style>
