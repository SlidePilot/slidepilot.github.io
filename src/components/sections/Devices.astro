---
import type { Dict } from '../../i18n/en';
interface Props { d: Dict }
const { d } = Astro.props;
const v = d.devices;
const devices = [
  { key: 'mac', data: v.mac },
  { key: 'ipad', data: v.ipad },
  { key: 'iphone', data: v.iphone },
] as const;
---
<section class="section devices">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">{v.eyebrow}</span>
      <h2 class="section-title">{v.title}</h2>
    </div>
    <div class="cards">
      {devices.map((dev, i) => (
        <article class="card device reveal" style={`--delay:${i * 0.07}s`}>
          <div class="art" aria-hidden="true">
            {dev.key === 'mac' && (
              <svg viewBox="0 0 200 130"><rect x="30" y="10" width="140" height="92" rx="8" class="body" /><rect x="37" y="17" width="126" height="78" rx="3" class="scr" /><path d="M14 108h172l-8 10H22z" class="body" /><rect x="50" y="28" width="62" height="40" rx="2" class="sl" /><rect x="118" y="28" width="38" height="24" rx="2" class="sl2" /><rect x="118" y="56" width="38" height="12" rx="2" class="nt" /></svg>
            )}
            {dev.key === 'ipad' && (
              <svg viewBox="0 0 200 130"><rect x="38" y="8" width="124" height="114" rx="12" class="body" /><rect x="46" y="16" width="108" height="98" rx="5" class="scr" /><rect x="56" y="38" width="88" height="56" rx="2" class="sl" /><path d="M80 66 q 18 -20 40 4" class="pen" /></svg>
            )}
            {dev.key === 'iphone' && (
              <svg viewBox="0 0 200 130"><rect x="72" y="4" width="56" height="122" rx="14" class="body" /><rect x="77" y="9" width="46" height="112" rx="10" class="scr" /><rect x="82" y="40" width="36" height="24" rx="2" class="sl" /><rect x="82" y="72" width="36" height="16" rx="2" class="nt" /><circle cx="100" cy="104" r="6" class="btn-c" /></svg>
            )}
          </div>
          <h3>{dev.data.title}</h3>
          <p>{dev.data.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .device { padding: 28px; text-align: center; }
  .art { height: 150px; display: grid; place-items: center; margin-bottom: 14px; }
  .art svg { width: 210px; height: auto; overflow: visible; }
  .body { fill: #1a1d24; stroke: rgba(255,255,255,.22); stroke-width: 1.2; }
  .scr { fill: #0a0c10; }
  .sl { fill: #f2f5fa; }
  .sl2 { fill: #c9d4e6; }
  .nt { fill: #3b8dff; opacity: .55; }
  .pen { fill: none; stroke: #ff3b8d; stroke-width: 3; stroke-linecap: round; }
  .btn-c { fill: var(--blue); }
  .device h3 { font-size: 20px; font-weight: 640; }
  .device p { color: var(--text-2); font-size: 15px; margin-top: 6px; }
  @media (max-width: 860px) { .cards { grid-template-columns: 1fr; } }
</style>
