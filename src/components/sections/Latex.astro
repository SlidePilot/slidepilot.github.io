---
import Icon from '../Icon.astro';
import type { Dict } from '../../i18n/en';
interface Props { d: Dict }
const { d } = Astro.props;
const l = d.latex;
---
<section class="section latex">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow"><Icon name="code" size={15} />{l.eyebrow}</span>
      <h2 class="section-title">{l.title}</h2>
    </div>

    <div class="grid">
      <article class="card big reveal">
        <div class="split-illo" aria-hidden="true">
          <div class="page">
            <div class="half slide-half"><i></i><div class="ell"></div></div>
            <div class="half notes-half"><b></b><b></b><b class="short"></b></div>
            <span class="kw">SP-Right</span>
          </div>
          <svg class="arrows" viewBox="0 0 120 160" fill="none">
            <path d="M6 80 C 50 80, 60 30, 112 26" />
            <path d="M6 80 C 50 80, 60 130, 112 134" />
          </svg>
          <div class="screens">
            <div class="screen">
              <span class="tag">{l.notes.audience}</span>
              <div class="mini slide-half"><i></i><div class="ell"></div></div>
            </div>
            <div class="screen">
              <span class="tag you">{l.notes.you}</span>
              <div class="mini notes-half"><b></b><b></b><b class="short"></b></div>
            </div>
          </div>
        </div>
        <div class="copy"><h3>{l.notes.title}</h3><p set:html={l.notes.text} /></div>
      </article>

      <article class="card calm reveal" style="--delay:.08s">
        <div class="term" aria-hidden="true">
          <div class="term-bar"><span></span><span></span><span></span></div>
          <pre><span class="c">$</span> latexmk -pdf -pvc talk.tex
<span class="m">Latexmk: applying rule 'pdflatex'…</span>
<span class="m">Output written on talk.pdf (24 pages).</span>
<span class="ok">✓ Done</span></pre>
          <div class="toast"><span class="spin"></span>{l.reload.status}</div>
        </div>
        <div class="copy"><h3>{l.reload.title}</h3><p>{l.reload.text}</p></div>
      </article>

      <article class="card calm reveal" style="--delay:.12s">
        <div class="links-illo" aria-hidden="true">
          <div class="vid">
            <div class="play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></div>
            <div class="progress"><span></span></div>
          </div>
          <div class="chips">
            <span><Icon name="external" size={13} />arxiv.org/abs/…</span>
            <span>→ Section 3</span>
          </div>
        </div>
        <div class="copy"><h3>{l.links.title}</h3><p>{l.links.text}</p></div>
      </article>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .big { grid-column: 1 / -1; display: grid; grid-template-columns: 1.25fr 1fr; align-items: center; }
  .card { display: flex; flex-direction: column; }
  .big.card { display: grid; }
  .copy { padding: 0 28px 26px; margin-top: auto; }
  .big .copy { padding: 36px 40px 36px 0; }
  .copy h3 { font-size: 17px; font-weight: 620; letter-spacing: -.015em; }
  .copy p { margin-top: 4px; color: var(--text-3); font-size: 14.5px; }
  .big .copy h3 { font-size: 22px; letter-spacing: -.022em; }
  .big .copy p { color: var(--text-2); font-size: 15.5px; margin-top: 8px; }
  .copy :global(code) { font-family: var(--mono); font-size: .86em; padding: 1px 5px; border-radius: 5px; background: rgba(255,255,255,.07); color: #cfe3ff; word-break: break-word; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    .big { grid-template-columns: 1fr; }
    .big .copy { padding: 0 28px 26px; }
  }

  /* split illustration */
  .split-illo { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 40px 28px; }
  .page { position: relative; display: flex; width: 54%; max-width: 300px; aspect-ratio: 8 / 3; background: #fff; border-radius: 6px; box-shadow: 0 20px 50px -20px rgba(0,0,0,.8); overflow: hidden; }
  .half { flex: 1; padding: 6% 5%; }
  .notes-half { background: #f3f5f9; border-left: 1px dashed #b5bfcf; }
  .slide-half i, .mini.slide-half i { display: block; height: 11%; width: 60%; background: #2b6fe6; border-radius: 2px; }
  .ell { margin: 10% auto 0; width: 60%; aspect-ratio: 2; border: 1.5px solid #2b6fe6; border-radius: 50%; }
  .notes-half b { display: block; height: 6px; margin-top: 10px; background: #c8d0dc; border-radius: 3px; }
  .notes-half b:first-child { margin-top: 4px; }
  .kw { position: absolute; right: 6px; top: -1px; transform: translateY(-120%); }
  .page .kw { position: absolute; left: 50%; top: auto; bottom: 6px; right: auto; transform: translateX(-50%); font: 600 10px var(--mono); color: #fff; background: #1e6bf5; padding: 2px 7px; border-radius: 999px; }
  .arrows { width: 60px; flex: none; }
  .arrows path { stroke: rgba(120,170,255,.6); stroke-width: 1.5; stroke-dasharray: 4 5; animation: dash 1.2s linear infinite; }
  @keyframes dash { to { stroke-dashoffset: -18; } }
  .screens { display: flex; flex-direction: column; gap: 22px; width: 30%; max-width: 160px; }
  .screen { position: relative; padding: 5px; border-radius: 8px; background: #16191f; border: 1px solid var(--border-strong); }
  .mini { aspect-ratio: 4 / 3; border-radius: 4px; background: #fff; padding: 9% 8%; }
  .mini.notes-half { border: none; background: #f3f5f9; }
  .tag { position: absolute; top: -9px; left: 8px; font-size: 10px; font-weight: 600; padding: 1px 7px; border-radius: 999px; background: #2a2f39; color: var(--text-2); }
  .tag.you { background: var(--blue-2); color: #fff; }

  /* terminal */
  .term { position: relative; margin: 24px 24px 20px; background: #0b0d11; border: 1px solid var(--border-strong); border-radius: 12px; overflow: hidden; min-height: 200px; }
  .term-bar { display: flex; gap: 6px; padding: 10px 12px; border-bottom: 1px solid var(--border); }
  .term-bar span { width: 10px; height: 10px; border-radius: 50%; background: #2c313b; }
  pre { margin: 0; padding: 14px 16px 64px; font: 12.5px/1.8 var(--mono); color: #d9e2f0; white-space: pre-wrap; }
  .c { color: var(--blue); } .m { color: #7d8697; } .ok { color: var(--green); }
  .toast {
    position: absolute; right: 12px; bottom: 12px; display: flex; align-items: center; gap: 9px;
    padding: 9px 13px; border-radius: 10px; font-size: 12.5px; font-weight: 550;
    background: rgba(30, 36, 48, .9); border: 1px solid var(--border-strong); backdrop-filter: blur(10px);
    animation: toast 5s var(--ease) infinite;
  }
  .spin { width: 12px; height: 12px; border-radius: 50%; border: 2px solid rgba(61,168,255,.3); border-top-color: var(--blue); animation: spin 1s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes toast { 0%, 55% { opacity: 1; transform: none; } 65% { opacity: 0; transform: translateY(8px); } 75% { opacity: 0; transform: translateY(8px); } 85%, 100% { opacity: 1; transform: none; } }

  /* links & video */
  .links-illo { margin: 24px 24px 20px; display: flex; flex-direction: column; gap: 14px; align-items: center; justify-content: center; min-height: 200px; }
  .vid { position: relative; width: min(100%, 300px); aspect-ratio: 16 / 9; border-radius: 10px; background: radial-gradient(circle at 30% 30%, #2a5bd7, #0d1a3d 70%); display: grid; place-items: center; overflow: hidden; border: 1px solid var(--border-strong); }
  .play { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.18); backdrop-filter: blur(8px); color: #fff; }
  .play svg { width: 22px; margin-left: 3px; }
  .progress { position: absolute; left: 10px; right: 10px; bottom: 10px; height: 3px; border-radius: 2px; background: rgba(255,255,255,.2); overflow: hidden; }
  .progress span { display: block; height: 100%; width: 0; background: #fff; animation: prog 6s linear infinite; }
  @keyframes prog { from { width: 35%; } to { width: 100%; } }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .chips span { display: inline-flex; align-items: center; gap: 5px; font: 500 12px var(--mono); padding: 5px 10px; border-radius: 999px; background: rgba(61,168,255,.1); color: #9fd0ff; border: 1px solid rgba(61,168,255,.25); }
</style>
