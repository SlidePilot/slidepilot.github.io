---
import Icon from '../Icon.astro';
import { path, type Locale } from '../../i18n';
import { APP_STORE_URL, GITHUB_DOWNLOAD_URL, GITHUB_URL } from '../../config';
import type { Dict } from '../../i18n/en';
interface Props { d: Dict; locale: Locale }
const { d, locale } = Astro.props;
const p = d.pricing;
---
<section class="section" id="pricing">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">{p.eyebrow}</span>
      <h2 class="section-title">{p.title}</h2>
      <p class="section-lead">
        {p.lead} <a class="link source" href={GITHUB_URL}><Icon name="github" size={15} />{p.source}</a>
      </p>
    </div>

    <div class="plans">
      <article class="card plan main reveal">
        <div class="top">
          <span class="label"><Icon name="apple" size={16} />{p.appStore.label}</span>
          <span class="flag">{p.appStore.recommended}</span>
        </div>
        <div class="price">{p.appStore.price}<span>{p.appStore.priceNote}</span></div>
        <p class="desc">{p.appStore.text}</p>
        <ul>{p.appStore.items.map((it) => <li><Icon name="check" size={15} />{it}</li>)}</ul>
        <a class="btn btn-primary" href={APP_STORE_URL}>{p.appStore.cta}<Icon name="arrow" size={16} /></a>
      </article>

      <article class="card plan alt reveal" style="--delay:.07s">
        <div class="top">
          <span class="label"><Icon name="github" size={16} />{p.github.label}</span>
        </div>
        <div class="price">{p.github.price}<span>{p.github.priceNote}</span></div>
        <p class="desc">{p.github.text}</p>
        <ul>{p.github.items.map((it) => <li><Icon name="check" size={15} />{it}</li>)}</ul>
        <a class="btn btn-secondary" href={GITHUB_DOWNLOAD_URL}>{p.github.cta}<Icon name="arrow" size={16} /></a>
      </article>
    </div>

    <p class="support reveal">
      <Icon name="heart" size={16} class="heart" />
      <span>{p.support.title}</span>
      <a class="link" href={APP_STORE_URL}>{p.support.buy}</a>
      <span class="sep" aria-hidden="true">·</span>
      <a class="link" href={path(locale, 'donate')}>{p.support.donate}</a>
      <span class="sep" aria-hidden="true">·</span>
      <button class="link share" type="button" data-share data-share-text={p.support.shareText} data-copied={p.support.copied}>
        <span data-label>{p.support.share}</span>
      </button>
    </p>
  </div>
</section>

<style>
  .source { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }

  .plans { display: grid; grid-template-columns: 1.2fr 1fr; gap: 16px; max-width: 900px; margin: 0 auto; align-items: center; }
  .plan { padding: 32px; display: flex; flex-direction: column; }
  .main {
    background: linear-gradient(180deg, rgba(30,107,245,.2), rgba(255,255,255,.02) 60%);
    border-color: rgba(61,168,255,.35);
    box-shadow: 0 30px 90px -30px rgba(30,107,245,.6);
    padding: 40px 36px;
  }
  .alt { background: transparent; }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .label { display: inline-flex; align-items: center; gap: 7px; font-size: 14px; color: var(--text-2); font-weight: 560; }
  .flag { font-size: 11.5px; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: rgba(61,168,255,.16); color: #9fd0ff; border: 1px solid rgba(61,168,255,.3); }

  .price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; margin-top: 18px; font-size: clamp(34px, 4.4vw, 44px); font-weight: 680; letter-spacing: -.04em; line-height: 1; }
  .price span { font-size: 15px; font-weight: 560; letter-spacing: -.01em; color: var(--blue); }
  .alt .price { font-size: clamp(28px, 3.2vw, 32px); color: var(--text); }
  .alt .price span { color: var(--text-3); }

  .desc { color: var(--text-2); font-size: 15px; margin-top: 16px; }
  .alt .desc { color: var(--text-3); }
  .plan ul { list-style: none; padding: 0; margin: 20px 0 28px; display: flex; flex-direction: column; gap: 8px; font-size: 14.5px; }
  .plan li { display: flex; gap: 9px; align-items: center; }
  .plan li :global(svg) { color: var(--blue); flex: none; }
  .alt li { color: var(--text-2); }
  .alt li :global(svg) { color: var(--text-3); }
  .plan .btn { width: 100%; }

  .support { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6px 10px; margin-top: 40px; font-size: 15px; color: var(--text-2); }
  .support .sep { color: var(--text-3); }
  .share { background: none; border: 0; padding: 0; font: inherit; cursor: pointer; }

  @media (max-width: 760px) {
    .plans { grid-template-columns: 1fr; }
    .main { padding: 32px 26px; }
    .plan { padding: 28px 24px; }
  }
</style>
