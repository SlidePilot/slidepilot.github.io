---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import Glyph from '../Glyph.astro';
import { screen } from '../screens';
import type { Locale } from '../../i18n';
import type { Dict } from '../../i18n/en';
interface Props { d: Dict; locale: Locale }
const { d, locale } = Astro.props;
const r = d.remote;
const icons = ['lock', 'wifi', 'eye'] as const; // one icon per point
---
<section class="section remote" id="remote">
  <div class="bg-glow" aria-hidden="true"></div>
  <div class="container layout">
    <div class="text">
      <div class="section-head reveal">
        <span class="eyebrow"><Icon name="wifi" size={15} />{r.eyebrow}</span>
        <h2 class="section-title">{r.title}</h2>
        <p class="section-lead">{r.lead}</p>
      </div>
      <ul class="points">
        {r.points.map((p, i) => (
          <li class="reveal" style={`--delay:${i * 0.07}s`}>
            <span class="pi"><Icon name={icons[i]} size={18} /></span>
            <div><h3>{p.title}</h3><p>{p.text}</p></div>
          </li>
        ))}
      </ul>
    </div>

    <div class="visual reveal" style="--delay:.1s">
      <div class="phone">
        <Image src={screen('remote', locale)} alt={r.alt} widths={[330, 660]} sizes="300px" />
      </div>
      <div class="pair card">
        <span class="pair-icon"><Glyph id="pair" /></span>
        <div>
          <small>{r.pairing}</small>
          <div class="code" aria-hidden="true"><span>482</span><span>913</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .remote { overflow: hidden; }
  .bg-glow { position: absolute; right: -10%; top: 10%; width: 700px; height: 700px; background: radial-gradient(closest-side, rgba(30,107,245,.22), transparent); z-index: -1; }
  .layout { display: grid; grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: center; }
  .points { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 22px; }
  .points li { display: flex; gap: 16px; }
  .pi { flex: none; width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: rgba(61,168,255,.1); border: 1px solid rgba(61,168,255,.25); color: var(--blue); }
  .points h3 { font-size: 17px; font-weight: 620; letter-spacing: -.015em; }
  .points p { color: var(--text-2); font-size: 15px; margin-top: 2px; }

  .visual { position: relative; display: grid; place-items: center; padding: 20px 0 40px; }
  .phone {
    width: min(300px, 70vw); border-radius: 48px; padding: 10px;
    background: linear-gradient(160deg, #3a3f4a, #15171c 40%, #2a2e36);
    box-shadow: 0 0 0 1px rgba(255,255,255,.08), 0 50px 100px -30px rgba(0,0,0,.9), 0 30px 120px -40px rgba(30,107,245,.6);
    transform: rotate(-4deg);
  }
  .phone :global(img) { border-radius: 39px; width: 100%; }
  .pair {
    position: absolute; left: 0; bottom: 18%; display: flex; align-items: center; gap: 14px;
    padding: 14px 18px; border-radius: 18px;
    background: rgba(20, 23, 30, .82); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 20px 50px -10px rgba(0,0,0,.7);
  }
  .pair-icon { width: 40px; height: 40px; border-radius: 11px; background: linear-gradient(#3da8ff, #0057f0 70%); display: grid; place-items: center; }
  .pair-icon :global(svg) { width: 72%; }
  .pair small { font-size: 11.5px; color: var(--text-3); }
  .code { display: flex; gap: 10px; font: 600 24px/1.1 var(--mono); letter-spacing: .08em; }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; gap: 32px; }
    .pair { left: 50%; transform: translateX(-100%); }
  }
</style>
