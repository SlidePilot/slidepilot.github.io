---
// Animated hero artwork: the SlidePilot glyph as a glass object that emits signal waves.
import { HUB, HORNS } from './logoPaths';
const waves = [0, 1, 2];
---
<div class="hero-art" data-hero-art aria-hidden="true">
  <div class="glow"></div>
  <div class="horizon"></div>

  <svg class="waves" viewBox="-488 -8 2000 1000" preserveAspectRatio="xMidYMid meet">
    <defs>
      <linearGradient id="wave-stroke" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#9fd2ff" />
        <stop offset="1" stop-color="#2a74ff" />
      </linearGradient>
    </defs>
    {waves.map((i) => (
      <path class="wave" style={`--i:${i}`} d={HORNS} fill="none" stroke="url(#wave-stroke)" stroke-width="1.4" vector-effect="non-scaling-stroke" />
    ))}
    <!-- static faint rings -->
    <path class="ring" d={HORNS} fill="none" stroke="rgba(160,200,255,.10)" stroke-width="1" vector-effect="non-scaling-stroke" style="--s:1.55" />
    <path class="ring" d={HORNS} fill="none" stroke="rgba(160,200,255,.07)" stroke-width="1" vector-effect="non-scaling-stroke" style="--s:2.1" />
    <path class="ring" d={HORNS} fill="none" stroke="rgba(160,200,255,.045)" stroke-width="1" vector-effect="non-scaling-stroke" style="--s:2.65" />
  </svg>

  <div class="stage" data-tilt>
    <svg class="glyph" viewBox="140 250 744 480">
      <defs>
        <linearGradient id="glass" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#8ccaff" />
          <stop offset=".55" stop-color="#3b8dff" />
          <stop offset="1" stop-color="#1557e8" />
        </linearGradient>
        <linearGradient id="rim" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffffff" stop-opacity=".95" />
          <stop offset=".35" stop-color="#ffffff" stop-opacity=".25" />
          <stop offset="1" stop-color="#ffffff" stop-opacity=".05" />
        </linearGradient>
        <linearGradient id="top-light" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffffff" stop-opacity=".55" />
          <stop offset=".5" stop-color="#ffffff" stop-opacity="0" />
        </linearGradient>
        <clipPath id="glyph-clip">
          <path d={HORNS} />
          <path d={HUB} />
        </clipPath>
        <filter id="soft-glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="28" />
        </filter>
      </defs>

      <!-- glow behind -->
      <g class="glyph-glow" filter="url(#soft-glow)">
        <path d={HORNS} fill="#2f7dff" />
        <path d={HUB} fill="#4aa3ff" />
      </g>

      <!-- body -->
      <path d={HORNS} fill="url(#glass)" />
      <path class="hub" d={HUB} fill="url(#glass)" />

      <!-- light -->
      <g clip-path="url(#glyph-clip)">
        <rect x="140" y="250" width="744" height="480" fill="url(#top-light)" />
      </g>

      <!-- rim highlight -->
      <path d={HORNS} fill="none" stroke="url(#rim)" stroke-width="3" />
      <path d={HUB} fill="none" stroke="url(#rim)" stroke-width="3" />
    </svg>
    <svg class="reflection" viewBox="140 250 744 480">
      <path d={HORNS} fill="#3b8dff" />
      <path d={HUB} fill="#3b8dff" />
    </svg>
  </div>
</div>

<script>
  const art = document.querySelector<HTMLElement>('[data-hero-art]');
  const stage = art?.querySelector<HTMLElement>('[data-tilt]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (art && stage && !reduce && matchMedia('(pointer: fine)').matches) {
    let raf = 0;
    let tx = 0, ty = 0, cx = 0, cy = 0;
    const loop = () => {
      cx += (tx - cx) * 0.06;
      cy += (ty - cy) * 0.06;
      stage.style.setProperty('--rx', `${(-cy * 8).toFixed(2)}deg`);
      stage.style.setProperty('--ry', `${(cx * 10).toFixed(2)}deg`);
      art.style.setProperty('--px', `${(cx * 24).toFixed(1)}px`);
      art.style.setProperty('--py', `${(cy * 16).toFixed(1)}px`);
      if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001) raf = requestAnimationFrame(loop);
      else raf = 0;
    };
    window.addEventListener('pointermove', (e) => {
      tx = e.clientX / window.innerWidth - 0.5;
      ty = e.clientY / window.innerHeight - 0.5;
      if (!raf) raf = requestAnimationFrame(loop);
    }, { passive: true });
  }
</script>

<style>
  .hero-art {
    position: relative;
    width: 100%;
    height: clamp(230px, 28vw, 370px);
    display: grid;
    place-items: center;
    isolation: isolate;
    --px: 0px; --py: 0px;
  }


  .glow {
    position: absolute; left: 50%; top: 50%;
    width: min(900px, 120vw); aspect-ratio: 1.6;
    transform: translate(-50%, -50%);
    background:
      radial-gradient(closest-side, rgba(40, 120, 255, .24), rgba(40, 120, 255, .07) 45%, transparent 75%);
    filter: blur(10px);
    z-index: -2;
  }


  .horizon {
    position: absolute; left: 50%; top: 84%;
    width: min(1600px, 200vw); height: 320px;
    transform: translateX(-50%);
    border-radius: 50%;
    border-top: 1px solid rgba(140, 190, 255, .55);
    background: radial-gradient(ellipse 50% 100% at 50% 0%, rgba(40,110,255,.22), transparent 70%);
    box-shadow: 0 -20px 80px -20px rgba(61, 140, 255, .55);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 25%, #000 75%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 25%, #000 75%, transparent);
    z-index: -1;
  }

  .waves {
    position: absolute; inset: 0; width: 100%; height: 100%;
    overflow: visible; z-index: -1;
    transform: translate(calc(var(--px) * -.6), calc(var(--py) * -.6));
  }
  .wave, .ring {
    transform-box: view-box;
    transform-origin: 512px 492px;
  }
  .ring { transform: scale(var(--s)); }
  .wave {
    opacity: 0;
    animation: emit 9s cubic-bezier(.25, .6, .3, 1) infinite;
    animation-delay: calc(var(--i) * 3s);
  }
  @keyframes emit {
    0% { transform: scale(1); opacity: 0; }
    8% { opacity: .5; }
    100% { transform: scale(2.9); opacity: 0; }
  }

  .stage {
    --rx: 0deg; --ry: 0deg;
    position: relative;
    width: clamp(170px, 24vw, 310px);
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    animation: float 8s ease-in-out infinite;
  }
  .glyph { width: 100%; overflow: visible; filter: drop-shadow(0 30px 60px rgba(10, 60, 200, .35)); }
  .glyph-glow { opacity: .6; }

  .reflection {
    position: absolute; left: 0; top: 100%; width: 100%;
    transform: scaleY(-1) translateY(-8%);
    opacity: .14;
    filter: blur(6px);
    -webkit-mask-image: linear-gradient(to top, #000, transparent 55%);
    mask-image: linear-gradient(to top, #000, transparent 55%);
  }

  @keyframes float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -10px; } }

  @media (prefers-reduced-motion: reduce) {
    .wave { display: none; }
  }
</style>
