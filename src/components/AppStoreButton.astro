---
import Icon from './Icon.astro';
import { APP_STORE_URL } from '../config';
import type { Dict } from '../i18n/en';
interface Props { d: Dict; size?: 'md' | 'lg' }
const { d, size = 'lg' } = Astro.props;
---
<a class:list={['store-btn', size]} href={APP_STORE_URL} rel="noopener">
  <Icon name="apple" size={size === 'lg' ? 26 : 20} />
  <span class="label">
    <span class="small">{d.hero.appStoreSmall}</span>
    <span class="big">{d.hero.appStoreBig}</span>
  </span>
</a>
<style>
  .store-btn {
    display: inline-flex; align-items: center; gap: 10px;
    height: 54px; padding: 0 22px 0 18px;
    border-radius: 14px;
    background: linear-gradient(180deg, #ffffff, #e3e9f3);
    color: #05070b;
    box-shadow: 0 0 0 1px rgba(255,255,255,.25), 0 10px 36px -10px rgba(110,170,255,.7), inset 0 -1px 0 rgba(0,0,0,.08);
    transition: transform .25s var(--ease), box-shadow .25s;
  }
  .store-btn:hover { transform: translateY(-1px); box-shadow: 0 0 0 1px rgba(255,255,255,.35), 0 16px 44px -10px rgba(110,170,255,.9); }
  .store-btn:active { transform: scale(.98); }
  .store-btn :global(svg) { margin-top: -3px; }
  .label { display: flex; flex-direction: column; line-height: 1.05; text-align: left; }
  .small { font-size: 11px; font-weight: 500; letter-spacing: .01em; opacity: .75; }
  .big { font-size: 20px; font-weight: 650; letter-spacing: -.02em; }
  .md { height: 46px; border-radius: 12px; padding: 0 18px 0 14px; }
  .md .big { font-size: 17px; }
  .md .small { font-size: 10px; }
</style>
