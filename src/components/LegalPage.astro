---
import Base from '../layouts/Base.astro';
import { t, path, type Locale } from '../i18n';

interface Props { locale: Locale; doc: 'imprint' | 'privacy' | 'terms' }
const { locale, doc } = Astro.props;
const d = t(locale);
const files = import.meta.glob<{ Content: any }>('../content/legal/*.md', { eager: true });
const { Content } = files[`../content/legal/${doc}.${locale}.md`];
const title = d.legal[doc];
---
<Base locale={locale} page={doc} title={`${title} – SlidePilot`} description={title}>
  <article class="legal container">
    <header>
      <h1 class="section-title">{title}</h1>
      <p class="meta">{d.legal.updated}: {locale === 'de' ? '26. November 2026' : locale === 'fr' ? '26 novembre 2026' : 'November 26, 2026'}</p>
      {locale !== 'de' && (
        <p class="note">{d.legal.translationNote} <a class="link" href={path('de', doc)} hreflang="de">{d.legal.germanVersion}</a></p>
      )}
    </header>
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .legal { max-width: 780px; padding-top: 140px; padding-bottom: 80px; }
  header { margin-bottom: 40px; }
  .meta { color: var(--text-3); font-size: 14px; margin-top: 14px; }
  .note { margin-top: 18px; padding: 12px 16px; border-radius: 12px; background: var(--surface); border: 1px solid var(--border); color: var(--text-2); font-size: 14px; }
  .prose { color: var(--text-2); font-size: 16px; line-height: 1.75; }
  .prose :global(h2) { color: var(--text); font-size: 20px; font-weight: 620; letter-spacing: -.015em; margin: 40px 0 10px; }
  .prose :global(p), .prose :global(ul) { margin: 0 0 14px; }
  .prose :global(ul) { padding-left: 20px; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose :global(a) { color: var(--text); text-decoration: underline; text-decoration-color: rgba(61,168,255,.6); text-underline-offset: 3px; word-break: break-word; }
</style>
