---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/sections/Hero.astro';
import Features from '../../components/sections/Features.astro';
import Latex from '../../components/sections/Latex.astro';
import Remote from '../../components/sections/Remote.astro';
import Devices from '../../components/sections/Devices.astro';
import Privacy from '../../components/sections/Privacy.astro';
import Pricing from '../../components/sections/Pricing.astro';
import Faq from '../../components/sections/Faq.astro';
import Cta from '../../components/sections/Cta.astro';
import { t, localePaths, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
---
<Base locale={locale}>
  <Hero d={d} locale={locale} />
  <Features d={d} locale={locale} />
  <Latex d={d} />
  <Remote d={d} locale={locale} />
  <Devices d={d} />
  <Privacy d={d} />
  <Pricing d={d} locale={locale} />
  <Faq d={d} locale={locale} />
  <Cta d={d} locale={locale} />
</Base>
